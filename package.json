{
  "name": "@championswimmer/pi-checklist",
  "version": "0.1.0",
  "description": "pi extension: session-scoped task checklist with dependencies and a live TUI renderer",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/championswimmer/pi-checklist.git"
  },
  "homepage": "https://github.com/championswimmer/pi-checklist#readme",
  "bugs": {
    "url": "https://github.com/championswimmer/pi-checklist/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
